generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  password    String
  location    String
  category    String?
  role        String   @default("PRODUCER")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdEvents   Event[]  @relation("CreatedEvents")
  partnerEvents   Event[]  @relation("EventPartners")
  receivedReviews Review[] @relation("TargetUserReviews")
  authoredReviews Review[] @relation("AuthoredReviews")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String?
  location    String
  date        DateTime?

  creatorId   String
  creator     User     @relation("CreatedEvents", fields: [creatorId], references: [id], onDelete: Cascade)

  partners    User[]   @relation("EventPartners")
  reviews     Review[]

  createdAt   DateTime @default(now())
}

model Review {
  id           String   @id @default(uuid())
  rating       Int
  description  String
  authorName   String

  authorId     String?
  author       User?    @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: SetNull)

  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  targetUserId String?
  targetUser   User?    @relation("TargetUserReviews", fields: [targetUserId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}